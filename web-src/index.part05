h3><p>Attività, predisposizioni e verifiche successive.</p></div><button type="button" class="btn ghost small" onclick="addOpenPoint()">＋ Punto aperto</button></div></div><div class="field w12"><div class="openpoints">${openPointEditorMarkup(r)}</div></div>
<div class="field w12" style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn blue" type="submit">SALVA SALA</button>${window.editingRoomId?`<button class="btn secondary" type="button" onclick="saveRoomThenPDF()">SALVA + PDF</button><button class="btn danger" type="button" onclick="deleteRoom('${r.id}')">ELIMINA</button>`:''}</div></form>`}
function photosMarkup(r){return(r.photos||[]).map((p,i)=>`<figure class="photo"><img src="${p.data}"><button type="button" onclick="removePhoto(${i})">×</button><figcaption>${esc(p.caption||'Foto sopralluogo')}</figcaption></figure>`).join('')}
function pathEditorMarkup(r){return `<table class="path-table"><thead><tr><th>Percorso</th><th>Disponibile?</th><th>Via</th><th>Lunghezza m</th><th>Note</th><th></th></tr></thead><tbody>${(r.paths||[]).map((p,i)=>`<tr><td class="path-label"><input data-path="label" data-pi="${i}" value="${attr(p.label)}"></td><td><select data-path="available" data-pi="${i}"><option></option>${['Sì','No','Da verificare'].map(x=>`<option ${p.available===x?'selected':''}>${x}</option>`).join('')}</select></td><td><select data-path="route" data-pi="${i}"><option></option>${['Pavimento','Controsoffitto','Canalina','Parete','Diretto','Altro'].map(x=>`<option ${p.route===x?'selected':''}>${x}</option>`).join('')}</select></td><td><input data-path="length" data-pi="${i}" type="number" step="0.1" value="${attr(p.length)}"></td><td><input data-path="notes" data-pi="${i}" value="${attr(p.notes)}" placeholder="opzionale"></td><td><button type="button" class="btn danger small" onclick="removePath(${i})">×</button></td></tr>`).join('')}</tbody></table><button type="button" class="btn ghost small" style="margin-top:8px" onclick="addPath()">＋ Aggiungi percorso</button>`}
function addPath(){let r=syncFormToRoom(currentRoomDraft());r.paths.push({id:uid(),label:'',available:'',route:'',length:'',notes:''});refreshRoomForm(r)}
function removePath(i){let r=syncFormToRoom(currentRoomDraft());r.paths.splice(i,1);refreshRoomForm(r)}
function pathsText(r){return (r.paths||[]).filter(p=>p.label&&(p.available||p.route||p.length||p.notes)).map(p=>`${p.label}: ${p.available||'n.d.'}${p.route?' · '+p.route:''}${p.length?' · ~'+p.length+' m':''}${p.notes?' · '+p.notes:''}`).join('\n')}
function openPointEditorMarkup(r){return(r.openPoints||[]).map((p,i)=>`<div class="openpoint"><input data-op="text" data-i="${i}" value="${attr(p.text)}" placeholder="Attività / verifica"><input data-op="owner" data-i="${i}" value="${attr(p.owner)}" placeholder="Responsabile"><select data-op="status" data-i="${i}">${['Aperto','In attesa','Chiuso'].map(x=>`<option ${p.status===x?'selected':''}>${x}</option>`).join('')}</select><button type="button" class="btn danger small" onclick="removeOpenPoint(${i})">×</button></div>`).join('')}
function currentRoomDraft(){return window.editingRoomId?state.rooms.find(x=>x.id===window.editingRoomId):window.tempRoom}
function syncFormToRoom(r){r=normalizeRoom(r);let f=$('#roomForm');if(!f)return r;Object.assign(r,Object.fromEntries(new FormData(f)));$$('[data-op]').forEach(el=>{let i=+el.dataset.i;r.openPoints[i]=r.openPoints[i]||{id:uid()};r.openPoints[i][el.dataset.op]=el.value});$$('[data-matrix-dev]').forEach(el=>{let d=el.dataset.matrixDev,k=el.dataset.matrixKey;r.matrix[d]=r.matrix[d]||{};r.matrix[d][k]=el.value});$$('[data-path]').forEach(el=>{let i=+el.dataset.pi;r.paths[i]=r.paths[i]||{id:uid()};r.paths[i][el.dataset.path]=el.value});if(window.editingRoomId){let idx=state.rooms.findIndex(x=>x.id===window.editingRoomId);if(idx>=0)state.rooms[idx]=r}else window.tempRoom=r;return r}
function refreshRoomForm(r){$('#modalBody').innerHTML=roomForm(r)}
function addPhotos(e){let r=syncFormToRoom(currentRoomDraft());[...e.target.files].forEach(file=>{let rd=new FileReader();rd.onload=()=>{r.photos.push({id:uid(),data:rd.result,caption:file.name.replace(/\.[^.]+$/,'')});refreshRoomForm(r)};rd.readAsDataURL(file)})}
function removePhoto(i){let r=syncFormToRoom(currentRoomDraft());r.photos.splice(i,1);refreshRoomForm(r)}
function addOpenPoint(){let r=syncFormToRoom(currentRoomDraft());r.openPoints.push({id:uid(),text:'',owner:'',status:'Aperto'});refreshRoomForm(r)}
function removeOpenPoint(i){let r=syncFormToRoom(currentRoomDraft());r.openPoints.splice(i,1);refreshRoomForm(r)}
function saveRoom(e){e.preventDefault();let r=syncFormToRoom(currentRoomDraft());if(!r.name.trim())return;if(!window.editingRoomId){state.rooms.push(r);window.tempRoom=null}save();closeModal();render();toast('Sala salvata')}
function saveRoomThenPDF(){let r=syncFormToRoom(currentRoomDraft());save();exportRoomPDF(r.id);closeModal();render()}
function duplicateRoom(id){let src=normalizeRoom(state.rooms.find(x=>x.id===id)),cp=JSON.parse(JSON.stringify(src));cp.id=uid();cp.name+=' — copia';cp.photos=[];cp.openPoints=(cp.openPoints||[]).map(x=>({...x,id:uid()}));state.rooms.push(cp);save();render();toast('Sala duplicata')}
function deleteRoom(id){if(!confirm('Eliminare definitivamente questa sala?'))return;state.rooms=state.rooms.filter(x=>x.id!==id);save();closeModal();render();toast('Sala eliminata')}
function openModal(){$('#modal').classList.add('show')}function closeModal(){$('#modal').classList.remove('show');window.tempRoom=null;window.editingRoomId=null}
function safeFile(s){return String(s||'report').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-zA-Z0-9_-]+/g,'_').replace(/^_+|_+$/g,'')}
function safePdfName(s){return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[<>:"/\\|?*]+/g,'').replace(/\s+/g,' ').trim()}
function siteSurveyBaseName(){let client=safePdfName(state.project.client)||'Cliente';let offer=safePdfName(state.project.opportunity)||'Offerta';return `${client}_${offer}_Site_Survey`}
function pdfHeader(doc,title,subtitle){doc.setFillColor(247,247,244);doc.rect(0,0,210,30,'F');doc.setTextColor(17,76,150);doc.setFont('helvetica','bold');doc.setFontSize(19);doc.text('AYNO',14,14);doc.setFontSize(6);doc.text('A STIM TECH GROUP COMPANY',14,20);doc.setDrawColor(17,76,150);doc.setLineWidth(.7);doc.line(14,26,196,26);doc.setTextColor(17,17,17);doc.setFontSize(21);doc.text(title,14,43);doc.setTextColor(100,100,100);doc.setFontSize(8.5);doc.text(doc.splitTextToSize(subtitle||'',182),14,50);return 60}
function ensurePage(doc,y,need,title){if(y+need>282){doc.addPage();return pdfHeader(doc,title,'Continua')}return y}
function pdfSection(doc,y,title,val,roomTitle){if(!String(val||'').trim())return y;y=ensurePage(doc,y,25,roomTitle);doc.setTextColor(17,76,150);doc.setFont('helvetica','bold');doc.setFontSize(9.5);doc.text(title.toUpperCase(),14,y);y+=5;doc.setDrawColor(215,215,210);doc.line(14,y,196,y);y+=6;doc.setTextColor(45,45,45);doc.setFont('helvetica','normal');doc.setFontSize(9);let lines=doc.splitTextToSize(String(val),182);doc.text(lines,14,y);return y+lines.length*4.3+6}
function matrixText(r){let labels={display:'Display',camera:'Telecamera',touch:'Pannello touch',table:'Tavolo AV',rack:'Rack',scheduler:'Pannello prenotazione sala'};return Object.entries(r.matrix||{}).map(([d,v])=>`${labels[d]||d}: Alimentazione ${v.power||'-'} | LAN ${v.network||'-'} | PoE ${v.poe||'-'} | AV ${v.av||'-'}`).join('\n')}
function addRoomToDoc(doc,rr,first=true){let r=normalizeRoom(rr),p=state.project;if(!first)doc.addPage();let headerTitle=p.client||'Cliente';let headerSubtitle=`Offerta: ${p.opportunity||'–'} · Site Survey · Sala: ${r.name||'–'} · Tipologia sala: ${r.type||'–'}${p.site?' · Sede: '+p.site:''}${p.project?' · Progetto: '+p.project:''} · Rev. ${p.revision||'0'} · ${p.date||''}`;let y=pdfHeader(doc,headerTitle,headerSubtitle);let facts=[['Sala',r.name||'–'],['Tipologia sala',r.type||'–'],['Piano',r.floor||'–'],['Capienza',r.capacity?r.capacity+' pax':'–'],['Dimensioni',[r.width,r.length,r.height].filter(Boolean).join(' × ')+(r.width||r.length||r.height?' m':'–')],['Piattaforma',r.platform||'–'],['Stato sala',r.readiness||'–']];facts.forEach((f,i)=>{let x=14+(i%3)*62,yy=y+Math.floor(i/3)*15;doc.setFont('helvetica','bold');doc.setFontSize(7);doc.setTextColor(115,115,115);doc.text(f[0].toUpperCase(),x,yy);doc.setFont('helvetica','normal');doc.setFontSize(9);doc.setTextColor(20,20,20);doc.text(doc.splitTextToSize(String(f[1]),58),x,yy+5)});y+=51;
let sections=[['Sede e accesso',`${p.address||''}${p.latitude&&p.longitude?`\nGPS: ${p.latitude}, ${p.longitude}${p.locationVerified?' · verificata':''}`:''}${p.accessNotes?`\nAccesso: ${p.accessNotes}`:''}`],['Descrizione e utilizzo',r.roomUse],['Tavolo',`${r.tableShape||''} ${r.tableA?'A '+r.tableA+' mm':''} ${r.tableB?'B '+r.tableB+' mm':''} ${r.tableC?'C '+r.tableC+' mm':''}\nMateriale: ${r.tableMaterial||'-'}\nAperture a carico cliente: ${r.clientCutouts||'-'} · Scatole da tavolo: ${r.tableBoxes||'-'}`],['Pareti',`Parete display: ${r.wall1||'-'} · ${r.wall1Finish||''}\nContenimenti: ${r.wall1Containment||'-'} · Rinforzo: ${r.wall1Reinforce||'-'} · Apparati installabili: ${r.wall1Fit||'-'}\n${r.wallsOther||''}`],['Controsoffitto',`${r.ceilingType||'-'} · Accessibile: ${r.ceilingAccessible||'-'}\n${r.ceilingObstructions||''}`],['AV esistente',r.existingAV],['Display / LED / proiezione',r.display],['Telecamera / videoconferenza',r.camera],['Audio / diffusori / microfoni',`${r.audio||''}\nMicrofoni: ${r.microphoneType||'-'}`],['Rete',r.network],['Alimentazione',r.power],['Cablaggi e percorsi',`${r.cabling||''}\nPassaggio vano: ${r.cableVoid||'-'} · Verticale: ${r.verticalRoute||'-'}`],['Percorsi AV principali',pathsText(r)],['Matrice predisposizioni',matrixText(r)],['Rack / arredi tecnici',`${r.rack||''}\nPosizione: ${r.rackLocation||'-'} · Ventilazione: ${r.rackVentilation||'-'}`],['Opere / adeguamenti',`${r.issues||''}\nResponsabile: ${r.constructionOwner||'-'}`],['Acustica',r.acoustics],['Illuminazione / luce naturale',r.lighting],['Stato sala',`${r.readiness}\n${r.readinessNotes||''}`],['Raccomandazione prevendita',r.recommendation],['Note',r.notes]];sections.forEach(s=>y=pdfSection(doc,y,s[0],s[1],p.client||'Cliente'));
if((r.openPoints||[]).length){y=ensurePage(doc,y,25,p.client||'Cliente');doc.setTextColor(17,76,150);doc.setFont('helvetica','bold');doc.setFontSize(9.5);doc.text('PUNTI APERTI',14,y);y+=7;(r.openPoints||[]).forEach((op,i)=>{y=ensurePage(doc,y,10,p.client||'Cliente');doc.setTextColor(35,35,35);doc.setFont('helvetica','normal');doc.setFontSize(8.5);let l=doc.splitTextToSize(`${i+1}. ${op.text||'Punto aperto'} — ${op.owner||'Responsabile n.d.'} — ${op.status||'Aperto'}`,180);doc.text(l,14,y);y+=l.length*4+3})}
if((r.photos||[]).length){doc.addPage();let py=pdfHeader(doc,p.client||'Cliente',`Sala: ${r.name||'–'} · Tipologia sala: ${r.type||'–'} · Foto sopralluogo`),col=0;for(let i=0;i<r.photos.length;i++){let ph=r.photos[i],x=14+col*92;try{doc.addImage(ph.data,'JPEG',x,py,86,57,undefined,'FAST')}catch(e){try{doc.addImage(ph.data,'PNG',x,py,86,57,undefined,'FAST')}catch(_){} }doc.setFontSize(7.5);doc.setTextColor(90,90,90);doc.text(doc.splitTextToSize(ph.caption||`Foto ${i+1}`,86),x,py+62);col++;if(col===2){col=0;py+=72}if(py>245&&i<r.photos.length-1){doc.addPage();py=pdfHeader(doc,p.client||'Cliente',`Sala: ${r.name||'–'} · Tipologia sala: ${r.type||'–'} · Foto sopralluogo`);col=0}}}
doc.setFontSize(7);doc.setTextColor(130,130,130);doc.text(`AYNO | ${p.client||''} | ${r.name}`,14,291)}
function exportRoomPDF(id){let r=state.rooms.find(x=>x.id===id);if(!r)return;let {jsPDF}=window.jspdf,doc=new jsPDF({unit:'mm',format:'a4'});addRoomToDoc(doc,r,true);let room=safePdfName(r.name)||'Sala';doc.save(`${siteSurveyBaseName()}_${room}.pdf`);toast('PDF sala generato')}
function exportFullReport(){if(!state.rooms.length)return toast('Aggiungi almeno una sala');let {jsPDF}=window.jspdf,doc=new jsPDF({unit:'mm',format:'a4'});state.rooms.forEach((r,i)=>addRoomToDoc(doc,r,i===0));doc.save(`${siteSurveyBaseName()}.pdf`);toast('PDF progetto generato')}
function downloadBackup(){save();let b=new Blob([JSON.stringify(projectStore,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='AYNO_FIELD_tutti_i_progetti_backup.json';a.click();URL.revokeObjectURL(a.href)}
function restoreBackup(e){let f=e.target.files[0];if(!f)return;let rd=new FileReader();rd.onload=()=>{try{let x=JSON.parse(rd.result);if(Array.isArray(x.projects)){projectStore=x;activeEntry=projectStore.projects.find(p=>p.id===projectStore.activeProjectId)||projectStore.projects[0]||null}else{const migrated={id:uid(),project:{...defaultProject,...x.project,configured:true},rooms:x.rooms||[]};projectStore={version:1,projects:[migrated],activeProjectId:migrated.id};activeEntry=migrated}state=activeEntry?{project:{...defaultProject,...activeEntry.project},rooms:(activeEntry.rooms||[]).map(normalizeRoom)}:{project:{...defaultProject},rooms:[]};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));window.currentView='projects';render();toast('Backup ripristinato')}catch(err){alert('Backup non valido')}};rd.readAsText(f)}
function newProject(){save();const entry={id:uid(),project:{...defaultProject,date:today()},rooms:[]};projectStore.projects.push(entry);projectStore.activeProjectId=entry.id;activeEntry=entry;state={project:{...entry.project},rooms:[]};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));window.currentView='project';render();toast('Nuovo progetto creato')}
if('serviceWorker'in navigator){navigator.serviceWorker.register('./sw.js').catch(()=>{})}render();
</script>
</body></html>
