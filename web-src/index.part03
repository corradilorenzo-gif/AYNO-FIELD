ctiveEntry.id===id){activeEntry=projectStore.projects[0]||null;projectStore.activeProjectId=activeEntry?activeEntry.id:null;state=activeEntry?{project:{...defaultProject,...activeEntry.project},rooms:(activeEntry.rooms||[]).map(normalizeRoom)}:{project:{...defaultProject},rooms:[]}}localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));window.currentView='projects';render();toast('Progetto eliminato')}
function renderDashboard(){save();let entries=projectStore.projects||[];let totalRooms=entries.reduce((n,e)=>n+(e.rooms||[]).length,0);let totalOpen=entries.reduce((n,e)=>n+(e.rooms||[]).reduce((m,r)=>m+(r.openPoints||[]).filter(x=>x.status!=='Chiuso').length,0),0);let totalReady=entries.reduce((n,e)=>n+(e.rooms||[]).filter(r=>r.readiness==='Pronta').length,0);let projectCards=entries.slice().reverse().slice(0,6).map(e=>{let p={...defaultProject,...e.project},rooms=e.rooms||[],active=!!activeEntry&&e.id===activeEntry.id;return `<article class="overview-project ${active?'active-project':''}"><div><div class="eyebrow">${active?'Progetto aperto':'Progetto'}</div><h3>${esc(p.project||'Progetto senza nome')}</h3><div class="meta">${esc(p.client||'Cliente da definire')} · ${esc(p.site||'Sede da definire')}</div><div class="meta" style="margin-top:8px">${rooms.length} ${rooms.length===1?'sala':'sale'} · ${rooms.reduce((n,r)=>n+(r.openPoints||[]).filter(x=>x.status!=='Chiuso').length,0)} punti aperti</div></div><div class="overview-actions"><button class="btn ${active?'secondary':'blue'} small" onclick="openProjectFromOverview('${e.id}')">${active?'VAI ALLE SALE':'APRI PROGETTO'}</button>${rooms.length?`<button class="btn ghost small" onclick="exportProjectFromArchive('${e.id}')">PDF PROGETTO</button>`:''}</div></article>`}).join('');let allRooms=[];entries.forEach(e=>(e.rooms||[]).forEach(r=>allRooms.push({room:normalizeRoom(r),entry:e})));let roomCards=allRooms.slice().reverse().slice(0,9).map(x=>{let p={...defaultProject,...x.entry.project},r=x.room;return `<article class="overview-room"><div><div class="eyebrow">${esc(p.project||'Progetto')} · ${esc(p.site||'')}</div><h3>${esc(r.name||'Sala senza nome')}</h3><div class="meta">${esc(r.floor||'Piano n.d.')} · ${esc(r.type||'Tipologia n.d.')}</div><div style="margin-top:10px">${readinessBadge(r)}</div></div><div class="overview-actions"><button class="btn ghost small" onclick="openRoomFromOverview('${x.entry.id}','${r.id}')">APRI SALA</button></div></article>`}).join('');$('#content').innerHTML=`<div class="hero"><div><div class="eyebrow">AYNO FIELD</div><h1>Il lavoro,<br><span class="accent">a colpo d'occhio.</span></h1><p class="lead">Accedi rapidamente ai progetti e alle sale sopralluogate, senza dover prima entrare in un singolo progetto.</p></div><button class="btn blue" onclick="newProject()">＋ NUOVO PROGETTO</button></div><div class="grid stats"><div class="stat"><b>${entries.length}</b><span>Progetti</span></div><div class="stat"><b>${totalRooms}</b><span>Sale rilevate</span></div><div class="stat"><b>${totalOpen}</b><span>Punti aperti</span></div><div class="stat"><b>${totalReady}</b><span>Sale pronte</span></div></div><section class="overview-section"><div class="overview-head"><div><div class="eyebrow">Progetti</div><h2>Progetti recenti</h2></div><button class="btn secondary small" onclick="showView('projects')">VEDI TUTTI</button></div>${projectCards?`<div class="overview-list">${projectCards}</div>`:`<div class="empty">Nessun progetto disponibile.</div>`}</section><section class="overview-section"><div class="overview-head"><div><div class="eyebrow">Sale</div><h2>Sale recenti</h2></div><button class="btn secondary small" onclick="showView('allrooms')">VEDI TUTTE LE SALE</button></div>${roomCards?`<div class="overview-list">${roomCards}</div>`:`<div class="empty">Nessuna sala ancora rilevata.</div>`}</section>`}
function openProjectFromOverview(id){save();const e=projectStore.projects.find(x=>x.id===id);if(!e)return;activeEntry=e;projectStore.activeProjectId=id;state={project:{...defaultProject,...e.project},rooms:(e.rooms||[]).map(normalizeRoom)};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));window.currentView=state.project.configured?'rooms':'project';render();toast('Progetto aperto')}
function openRoomFromOverview(projectId,roomId){save();const e=projectStore.projects.find(x=>x.id===projectId);if(!e)return;activeEntry=e;projectStore.activeProjectId=projectId;state={project:{...defaultProject,...e.project},rooms:(e.rooms||[]).map(normalizeRoom)};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));window.currentView='rooms';render();setTimeout(()=>editRoom(roomId),0)}
function readinessBadge(r){const val=r?.readiness||'Da verificare';const cls=val==='Pronta'?'ready':val==='Pronta con attività'?'conditional':val==='Non pronta'?'notready':'';return `<span class="readiness ${cls}">${esc(val)}</span>`}
function roomCardMarkup(r,projectEntry=null){r=normalizeRoom(r);let c=completion(r),pe=projectEntry||activeEntry,p={...defaultProject,...(pe?.project||state.project)},projectId=pe?.id||activeEntry?.id||'';return `<article class="room-card"><div><div class="eyebrow">${esc(p.client||'Cliente')} · ${esc(p.project||'Progetto')}</div><h3>${esc(r.name||'Sala senza nome')}</h3><div class="meta"><b>${esc(p.site||'Sede n.d.')}</b> · ${esc(r.floor||'Piano n.d.')} · ${esc(r.type||'Tipologia n.d.')}</div><div style="margin-top:10px">${readinessBadge(r)}</div><div style="margin-top:16px"><div class="progress"><i style="width:${c}%"></i></div><div class="meta" style="margin-top:5px">Completezza ${c}%</div></div></div><div class="room-actions"><button class="btn ghost small" onclick="openRoomFromArchive('${projectId}','${r.id}')">APRI</button><button class="btn secondary small" onclick="exportRoomFromArchive('${projectId}','${r.id}')">PDF SALA</button><button class="btn danger small" onclick="deleteRoomFromArchive('${projectId}','${r.id}')">ELIMINA</button></div></article>`}
function roomsMarkupGlobal(){let all=[];(projectStore.projects||[]).forEach(e=>(e.rooms||[]).forEach(r=>all.push({r,e})));if(!all.length)return `<div class="empty"><b>Nessuna sala ancora rilevata.</b><br><br>${activeEntry&&state.project.configured?`<button class="btn blue" onclick="openRoomModal()">＋ NUOVA SALA</button>`:`<button class="btn blue" onclick="newProject()">＋ CREA UN PROGETTO</button>`}</div>`;return `<div class="rooms">${all.map(x=>roomCardMarkup(x.r,x.e)).join('')}</div>`}
function openRoomFromArchive(projectId,roomId){const e=projectStore.projects.find(x=>x.id===projectId);if(!e)return;activeEntry=e;projectStore.activeProjectId=e.id;state={project:{...defaultProject,...e.project},rooms:(e.rooms||[]).map(normalizeRoom)};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));window.currentView='rooms';render();setTimeout(()=>editRoom(roomId),0)}
function exportRoomFromArchive(projectId,roomId){const e=projectStore.projects.find(x=>x.id===projectId);if(!e)return;activeEntry=e;projectStore.activeProjectId=e.id;state={project:{...defaultProject,...e.project},rooms:(e.rooms||[]).map(normalizeRoom)};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));exportRoomPDF(roomId)}
function exportProjectFromArchive(projectId){save();const e=projectStore.projects.find(x=>x.id===projectId);if(!e)return;activeEntry=e;projectStore.activeProjectId=e.id;state={project:{...defaultProject,...e.project},rooms:(e.rooms||[]).map(normalizeRoom)};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));exportFullReport()}
function deleteRoomFromArchive(projectId,roomId){const e=projectStore.projects.find(x=>x.id===projectId);if(!e)return;const r=(e.rooms||[]).find(x=>x.id===roomId);if(!confirm(`Eliminare definitivamente la sala “${r?.name||'senza nome'}”?`))return;e.rooms=(e.rooms||[]).filter(x=>x.id!==roomId);if(activeEntry&&activeEntry.id===e.id)state.rooms=e.rooms.map(normalizeRoom);localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));render();toast('Sala eliminata')}
function renderRooms(){
  if(!activeEntry){renderNoProject('rooms');return}
  const total=state.rooms.length,p=state.project;
  const cards=total?`<div class="rooms">${state.rooms.map(r=>roomCardMarkup(r,activeEntry)).join('')}</div>`:`<div class="empty"><b>Nessuna sala in questo progetto.</b><br><br><button class="btn blue" onclick="openRoomModal()">＋ NUOVA SALA</button></div>`;
  $('#content').innerHTML=`<div class="hero"><div><div class="eyebrow">${esc(p.client||'Cliente')} · ${esc(p.site||'Sede')}</div><h1>Sale del<br><span class="accent">progetto.</span></h1><p class="lead">${esc(p.project||'Progetto')} · ${total} ${total===1?'sala':'sale'} associate a questo sopralluogo.</p></div><div style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn secondary" onclick="exportFullReport()">PDF PROGETTO</button><button class="btn blue" onclick="openRoomModal()">＋ NUOVA SALA</button></div></div>${cards}`
}
function renderAllRooms(){
  const total=(projectStore.projects||[]).reduce((n,e)=>n+(e.rooms||[]).length,0);
  $('#content').innerHTML=`<div class="hero"><div><div class="eyebrow">Archivio globale</div><h1>Tutte le<br><span class="accent">sale.</span></h1><p class="lead">Consulta le sale di tutti i progetti. Ogni card mostra chiaramente cliente, progetto e sede di appartenenza.</p></div><button class="btn secondary" onclick="showView('dashboard')">← PANORAMICA</button></div><div class="section-head"><div><div class="eyebrow">Archivio</div><h2>${total} ${total===1?'sala':'sale'} rilevate</h2></div></div>${roomsMarkupGlobal()}`
}
function renderOpenPoints(){let pts=[];state.rooms.forEach(r=>(r.openPoints||[]).forEach(p=>pts.push({...p,room:r.name,roomId:r.id})));$('#content').innerHTML=`<div class="hero"><div><div class="eyebrow">Attività successive</div><h1>Punti <span class="accent">aperti.</span></h1><p class="lead">Predisposizioni, verifiche e attività che possono influenzare consegna e installazione.</p></div></div>${pts.length?`<div class="card"><div class="openpoints">${pts.map(p=>`<div class="openpoint"><div><b>${esc(p.text)}</b><div class="meta">${esc(p.room)} · ${esc(p.owner||'Non assegnato')}</div></div><span class="pill">${esc(p.status)}</span><button class="btn ghost small" onclick="editRoom('${p.roomId}')">Apri sala</button></div>`).join('')}</div></div>`:`<div class="empty">Nessun punto aperto registrato.</div>`}`}
function renderProject(){let p=state.project;$('#content').innerHTML=`<div class="hero"><div><div class="eyebrow">Impostazioni progetto</div><h1>${esc(p.client)}.</h1><p class="lead">${esc(p.project)} · ${esc(p.site)}</p></div><button class="btn blue" onclick="openProjectModal()">MODIFICA</button></div><div class="card project-summary">${[['Cliente',p.client],['Sede',p.site],['Progetto',p.project],['Opportunità',p.opportunity],['Commerciale',p.sales],['Prevendita',p.presales],['Condizione sito',p.siteCondition],['Tipologia',p.workType],['Consegna attesa',p.deliveryDate],['Piattaforma',p.defaultPlatform],['Documentazione',p.drawings],['Ambito',p.scope]].map(x=>`<div class="kv"><label>${x[0]}</label><div>${esc(x[1]||'–')}</div></div>`).join('')}</div>`}
function openRoomModal(id=null){window.editingRoomId=id;window.tempRoom=id?null:blankRoom();let r=id?normalizeRoom(state.rooms.find(x=>x.id===id)):window.tempRoom;$('#modalTitle').textContent=id?'Modifica sala':'Nuova sala';const p=state.project;const crumb=`<div class="breadcrumb"><b>${esc(p.client||'Cliente')}</b> / ${esc(p.project||'Progetto')} / ${esc(p.site||'Sede')} / ${esc(r.name||'Nuova sala')}</div>`;$('#modalBody').innerHTML=crumb+roomForm(r);openModal()}
function editRoom(id){openRoomModal(id)}
function yn(name,val){return `<select name="${name}"><option></option><option ${val==='Sì'?'selected':''}>Sì</option><option ${val==='No'?'selected':''}>No</option><option ${val==='N/A'?'selected':''}>N/A</option></select>`}
function matrixCell(dev,key,val){return `<select data-matrix-dev="${dev}" data-matrix-key="${key}"><option></option><option ${val==='Sì'?'selected':''}>Sì</option><option ${val==='No'?'selected':''}>No</option><option ${val==='N/A'?'selected':''}>N/A</option></select>`}
function tableShapeHint(shape){const hints={"Rettangolare":"A = lunghezza del tavolo · B = profondità/larghezza.","Ovale":"A = lunghezza massima · B = larghezza massima.","Trapezoidale":"A = lato frontale · B = profondità · C = lato posteriore o inclinato.","Rotondo":"A = diametro del tavolo.","Modulare":"A = lunghezza totale · B = profondità · C = misura del singolo modulo.","Altro":"Usa A, B e C per le misure principali che ritieni utili."};return hints[shape]||"Seleziona la forma del tavolo per vedere un riferimento grafico e capire a cosa corrispondono A, B e C."}
function tableShapeSelector(selected){const cards=[
{name:'Rettangolare',note:'A = lunghezza · B = profondità',svg:`<svg viewBox="0 0 180 80" aria-hidden="true"><rect x="35" y="18" width="110" height="44" rx="4" fill="none" stroke="#111" stroke-width="2"/><line x1="45" y1="10" x2="135" y2="10" stroke="#114c96" stroke-width="2"/><polygon points="45,10 51,6 51,14" fill="#114c96"/><polygon points="135,10 129,6 129,14" fill="#114c96"/><text x="90" y="8" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">A</text><line x1="25" y1="22" x2="25" y2="58" stroke="#114c96" stroke-width="2"/><polygon points="25,22 21,28 29,28" fill="#114c96"/><polygon points="25,58 21,52 29,52" fill="#114c96"/><text x="18" y="42" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">B</text></svg>`},
{name:'Ovale',note:'A = lunghezza · B = larghezza',svg:`<svg viewBox="0 0 180 80" aria-hidden="true"><ellipse cx="90" cy="40" rx="58" ry="24" fill="none" stroke="#111" stroke-width="2"/><line x1="40" y1="10" x2="140" y2="10" stroke="#114c96" stroke-width="2"/><polygon points="40,10 46,6 46,14" fill="#114c96"/><polygon points="140,10 134,6 134,14" fill="#114c96"/><text x="90" y="8" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">A</text><line x1="90" y1="20" x2="90" y2="60" stroke="#114c96" stroke-width="2"/><polygon points="90,20 86,26 94,26" fill="#114c96"/><polygon points="90,60 86,54 94,54" fill="#114c96"/><text x="100" y="42" font-size="12" fill="#114c96" font-weight="700">B</text></svg>`},
{name:'Trapezoidale',note:'A = lato frontale · B = profondità · C = lato posteriore',svg:`<svg viewBox="0 0 180 80" aria-hidden="true"><polygon points="40,20 140,12 120,62 50,62" fill="none" stroke="#111" stroke-width="2"/><line x1="45" y1="10" x2="135" y2="4" stroke="#114c96" stroke-width="2"/><polygon points="45,10 50,5 51,13" fill="#114c96"/><polygon points="135,4 129,1 130,9" fill="#114c96"/><text x="93" y="8" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">A</text><line x1="24" y1="22" x2="24" y2="60" stroke="#114c96" stroke-width="2"/><polygon points="24,22 20,28 28,28" fill="#114c96"/><polygon points="24,60 20,54 28,54" fill="#114c96"/><text x="16" y="42" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">B</text><line x1="53" y1="70" x2="120" y2="70" stroke="#114c96" stroke-width="2"/><polygon points="53,70 59,66 59,74" fill="#114c96"/><polygon points="120,70 114,66 114,74" fill="#114c96"/><text x="87" y="67" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">C</text></svg>`},
{name:'Rotondo',note:'A = diametro',svg:`<svg viewBox="0 0 180 80" aria-hidden="true"><circle cx="90" cy="40" r="27" fill="none" stroke="#111" stroke-width="2"/><line x1="63" y1="40" x2="117" y2="40" stroke="#114c96" stroke-width="2"/><polygon points="63,40 69,36 69,44" fill="#114c96"/><polygon points="117,40 111,36 111,44" fill="#114c96"/><text x="90" y="35" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">A</text></svg>`},
{name:'Modulare',note:'A = lunghezza totale · B = profondità · C = modulo',svg:`<svg viewBox="0 0 180 80" aria-hidden="true"><rect x="40" y="20" width="100" height="40" fill="none" stroke="#111" stroke-width="2"/><line x1="90" y1="20" x2="90" y2="60" stroke="#111" stroke-width="2"/><line x1="40" y1="12" x2="140" y2="12" stroke="#114c96" stroke-width="2"/><polygon points="40,12 46,8 46,16" fill="#114c96"/><polygon points="140,12 134,8 134,16" fill="#114c96"/><text x="90" y="10" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">A</text><line x1="26" y1="22" x2="26" y2="58" stroke="#114c96" stroke-width="2"/><polygon points="26,22 22,28 30,28" fill="#114c96"/><polygon points="26,58 22,52 30,52" fill="#114c96"/><text x="18" y="42" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">B</text><line x1="40" y1="68" x2="90" y2="68" stroke="#114c96" stroke-width="2"/><polygon points="40,68 46,64 46,72" fill="#114c96"/><polygon points="90,68 84,64 84,72" fill="#114c96"/><text x="65" y="66" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">C</text></svg>`},
{name:'Altro',note:'Forma speciale: usa A, B e C come riferimento libero',svg:`<svg viewBox="0 0 180 80" aria-hidden="true"><path d="M45 20 L120 15 L140 35 L120 58 L55 62 L35 40 Z" fill="none" stroke="#111" stroke-width="2" stroke-dasharray="5 4"/><text x="90" y="44" text-anchor="middle" font-size="12" fill="#114c96" font-weight="700">A / B / C</text></svg>`}
];return `<div class="shape-grid">${cards.map(c=>`<label class="shape-card"><input type="radio" name="tableShape" value="${c.name}" ${selected===c.name?'checked':''} onchange="updateTableShapeHint(this.value)"><div class="shape-card-inner"><div class="shape-card-title">${c.name}</div>${c.svg}<div class="shape-card-note">${c.note}</div></div></label>`).join('')}</div><div class="table-dim-hint" id="tableShapeHint">${tableShapeHint(selected)}</div>`}
function updateTableShapeHint(shape){const el=document.getElementById('tableShapeHint');if(el)el.innerHTML=tableShapeHint(shape)}
function roomTypeHint(type){const hints={
'Phone Room':'1–2 persone · ambiente molto compatto per chiamate o video individuali.',
'Small Room':'3–7 persone · piccola sala riunioni / hud