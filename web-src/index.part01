<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#114c96" />
<title>AYNO FIELD 0.9.3 — Sopralluogo AV</title>
<link rel="manifest" href="manifest.json?v=08" />
<link rel="icon" href="icon.svg?v=08" type="image/svg+xml" />
<link rel="shortcut icon" href="icon.svg?v=08" type="image/svg+xml" />
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<style>
:root{--ink:#111;--paper:#f7f7f4;--white:#fff;--muted:#66645f;--line:#d2d2cc;--blue:#114c96;--blue2:#0b3b78;--danger:#b93131;--warn:#9a6900;--ok:#24704d}
*{box-sizing:border-box}html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer}.app{min-height:100vh}.topbar{height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;border-bottom:1px solid var(--line);background:rgba(247,247,244,.97);position:sticky;top:0;z-index:30}.brand{display:flex;align-items:center;gap:14px}.ayno{font-size:31px;font-weight:900;letter-spacing:-.06em;color:var(--blue)}.sep{width:1px;height:34px;background:var(--blue)}.sub{font-size:7px;line-height:1.45;letter-spacing:.24em;color:var(--blue);font-weight:800}.fieldname{font-size:11px;letter-spacing:.13em;font-weight:800;margin-left:14px}.shell{display:grid;grid-template-columns:245px 1fr;min-height:calc(100vh - 64px)}.sidebar{border-right:1px solid var(--line);padding:22px 16px;position:sticky;top:64px;height:calc(100vh - 64px);overflow:auto}.navbtn{display:block;width:100%;border:0;background:transparent;text-align:left;padding:13px 12px;margin:1px 0;font-weight:700}.navbtn:hover,.navbtn.active{background:#111;color:#fff}.navbtn .badge{float:right;background:var(--blue);color:#fff;padding:2px 6px;font-size:11px}.content{padding:38px clamp(18px,4vw,58px) 80px;max-width:1500px;width:100%;margin:auto}.eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:10px;font-weight:800;color:#6a6964}.hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:26px;align-items:end;margin-bottom:34px}h1{font-size:clamp(48px,6vw,86px);line-height:.92;letter-spacing:-.065em;margin:6px 0 0;font-weight:500}h2{font-size:30px;letter-spacing:-.04em;margin:0 0 16px}h3{font-size:19px;margin:0}.lead{font-size:18px;line-height:1.45;max-width:780px;color:#4f4e4a}.accent{color:var(--blue)}.btn{border:1px solid #111;background:#111;color:#fff;border-radius:0;padding:12px 17px;font-weight:800}.btn.secondary{background:transparent;color:#111}.btn.blue{background:var(--blue);border-color:var(--blue)}.btn.ghost{background:#fff;color:#111;border-color:var(--line)}.btn.danger{background:#fff;color:var(--danger);border-color:#d7a1a1}.btn.small{padding:8px 11px;font-size:12px}.grid{display:grid;gap:14px}.stats{grid-template-columns:repeat(4,1fr)}.stat,.card{background:#fff;border:1px solid var(--line);padding:22px}.stat b{display:block;font-size:34px;letter-spacing:-.05em}.stat span{font-size:12px;color:var(--muted)}.section{margin-top:30px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:13px}.rooms{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.room-card{background:#fff;border:1px solid var(--line);min-height:255px;padding:20px;display:flex;flex-direction:column;justify-content:space-between}.room-card h3{font-size:29px;letter-spacing:-.04em;margin:7px 0}.meta{font-size:12px;color:#686762}.progress{height:6px;background:#e3e3de}.progress i{display:block;height:100%;background:var(--blue)}.room-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:13px}.readiness{font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:800;padding:6px 8px;display:inline-block;border:1px solid}.readiness.ready{color:var(--ok);border-color:#8dbca4}.readiness.conditional{color:var(--warn);border-color:#d2b469}.readiness.notready{color:var(--danger);border-color:#d89a9a}.form-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:13px}.field{grid-column:span 4}.w6{grid-column:span 6}.w8{grid-column:span 8}.w12{grid-column:span 12}.field label{display:block;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#66645f;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);background:#fbfbf9;border-radius:0;padding:11px 12px;outline:none}.field textarea{min-height:95px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:#111;background:#fff}.group{grid-column:1/-1;border-top:1px solid #111;margin-top:10px;padding-top:20px}.group-title{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:13px}.group-title h3{font-size:21px;letter-spacing:-.03em}.group-title p{margin:3px 0 0;color:#777;font-size:12px;max-width:650px}.option-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.toggle{border:1px solid var(--line);background:#fff;padding:10px 11px;display:flex;gap:7px;align-items:center;font-size:13px}.toggle input{width:auto}.matrix{width:100%;border-collapse:collapse;background:#fff}.matrix th,.matrix td{border:1px solid var(--line);padding:9px;text-align:center;font-size:12px}.matrix th:first-child,.matrix td:first-child{text-align:left;font-weight:700}.photo-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.photo{position:relative;aspect-ratio:4/3;margin:0;border:1px solid var(--line);overflow:hidden;background:#eee}.photo img{width:100%;height:100%;object-fit:cover}.photo button{position:absolute;right:5px;top:5px;width:27px;height:27px;border:0;background:rgba(0,0,0,.75);color:#fff}.photo figcaption{position:absolute;left:0;right:0;bottom:0;padding:22px 7px 7px;color:#fff;font-size:10px;background:linear-gradient(transparent,rgba(0,0,0,.8))}.photo-add{aspect-ratio:4/3;border:1px dashed #999;background:#fafaf7;display:grid;place-items:center;color:#666;font-size:13px}.photo-add input{display:none}.openpoints{display:grid;gap:8px}.openpoint{display:grid;grid-template-columns:1fr 150px 120px auto;gap:8px;align-items:center}.empty{border:1px dashed #aaa;padding:40px;text-align:center;color:#777}.modal{position:fixed;inset:0;background:rgba(0,0,0,.56);display:none;z-index:80;padding:18px;align-items:center;justify-content:center}.modal.show{display:flex}.modal-card{width:min(1080px,100%);max-height:94vh;overflow:auto;background:#fff;padding:24px}.modal-head{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:20px}.close{border:0;background:#eee;width:34px;height:34px;font-size:20px}.toast{position:fixed;right:18px;bottom:18px;background:#111;color:#fff;padding:11px 15px;transform:translateY(100px);opacity:0;transition:.2s;z-index:100}.toast.show{transform:none;opacity:1}.setup-wrap{max-width:1150px;margin:auto}.setup-head{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:end;margin:18px 0 36px}.setup-head p{margin:0}.setup-actions{display:flex;justify-content:flex-end;gap:8px}.project-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.kv label{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#777;font-weight:800;display:block;margin-bottom:4px}.footer-note{font-size:11px;color:#777;margin-top:5px}.pill{padding:4px 7px;border:1px solid var(--line);font-size:10px;text-transform:uppercase;letter-spacing:.08em}.dangerbox{border:1px solid #ddb1b1;background:#fff8f8;padding:12px}.warnbox{border:1px solid #ddc68a;background:#fffdf5;padding:12px}.location-panel{grid-column:1/-1;border:1px solid var(--line);background:#fbfbf9;padding:16px;display:grid;grid-template-columns:1fr auto;gap:14px;align-items:start}.location-status{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}.location-chip{font-size:10px;text-transform:uppercase;letter-spacing:.08em;border:1px solid var(--line);padding:5px 7px;background:#fff}.location-chip.ok{border-color:#8dbca4;color:var(--ok)}.location-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.map-preview{grid-column:1/-1;border:1px solid var(--line);height:220px;background:#eee;display:none}.map-preview.show{display:block}.map-preview iframe{width:100%;height:100%;border:0}.shape-grid{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.shape-card{display:block;cursor:pointer}.shape-card input{position:absolute;opacity:0;pointer-events:none}.shape-card-inner{border:1px solid var(--line);background:#fff;padding:12px;min-height:126px;display:flex;flex-direction:column;gap:8px;justify-content:space-between}.shape-card input:checked + .shape-card-inner{border-color:#111;box-shadow:inset 0 0 0 1px #111}.shape-card-title{font-size:12px;font-weight:800;letter-spacing:.03em}.shape-card-note{font-size:11px;color:#666;line-height:1.35}.shape-card svg{width:100%;height:56px}.roomtype-grid{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.roomtype-card{display:block;cursor:pointer}.roomtype-card input{position:absolute;opacity:0;pointer-events:none}.roomtype-inner{border:1px solid var(--line);background:#fff;min-height:222px;padding:13px;display:flex;flex-direction:column;gap:8px;justify-content:space-between}.roomtype-visual{background:#f6f7f5;border-top:1px solid #ecece7;border-bottom:1px solid #ecece7;margin:2px -13px 0;padding:8px 10px}.roomtype-purpose{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--blue);margin-top:2px}.roomtype-card-desc{font-size:11px;line-height:1.35;color:#555}.roomtype-card svg{width:100%;height:102px}.roomtype-card input:checked + .roomtype-inner{border-color:var(--blue);box-shadow:inset 0 0 0 2px var(--blue)}.roomtype-card-title{font-size:14px;font-weight:800;line-height:1.15}.roomtype-card-meta{font-size:11px;color:#686762;line-height:1.35}.roomtype-hint{grid-column:1/-1;border:1px dashed #c7c7c1;background:#fbfbf9;padding:10px 12px;font-size:12px;color:#5d5c56}.roomtype-hint b{color:#111}.table-dim-hint{grid-column:1/-1;border:1px dashed #c7c7c1;background:#fbfbf9;padding:10px 12px;font-size:12px;color:#5d5c56}.table-dim-hint b{color:#111}.projects-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.project-card{background:#fff;border:1px solid var(--line);padding:20px;min-height:220px;display:flex;flex-direction:column;justify-content:space-between}.project-card.active-project{border-color:var(--blue);box-shadow:inset 0 0 0 1px var(--blue)}.project-card h3{font-size:26px;letter-spacing:-.04em;margin:6px 0}.project-card-actions{display:flex;gap:7px;flex-wrap:wrap}.overview-section{margin-top:34px}.overview-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:14px}.overview-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.overview-project,.overview-room{background:#fff;border:1px solid var(--line);padding:18px;display:flex;flex-direction:column;justify-content:space-between;min-height:190px}.overview-project.active-project{border-color:var(--blue);box-shadow:inset 0 0 0 1px var(--blue)}.overview-project h3,.overview-room h3{font-size:23px;letter-spacing:-.035em;margin:6px 0}.overview-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:16px}@media(max-width:900px){.overview-list{grid-template-columns:1fr}}.path-table{width:100%;border-collapse:collapse;background:#fff}.path-table th,.path-table td{border:1px solid var(--line);padding:7px;font-size:12px;vertical-align:middle}.path-table th{text-align:left}.path-table input,.path-table select{width:100%;border:0;background:transparent;padding:5px;outline:none}.path-table .path-label{font-weight:700;min-width:120px}@media(max-width:900px){.projects-grid{grid-template-columns:1fr}.path-table{display:block;overflow-x:auto}}@media (max-width: 1100px){.roomtype-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media (max-width: 900px){.shape-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.roomtype-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media (max-width: 620px){.shape-grid,.roomtype-grid{grid-template-columns:1fr}}
@media(max-width:1050px){.shell{grid-template-columns:1fr}.sidebar{display:none}.rooms{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.photo-grid{grid-template-columns:repeat(3,1fr)}.option-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.location-panel{grid-template-columns:1fr}.location-actions{justify-content:flex-start}.map-preview{height:180px}.topbar{padding:0 14px}.fieldname{display:none}.content{padding:26px 13px 70px}.hero,.setup-head{grid-template-columns:1fr}.rooms{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.field,.w6,.w8,.w12{grid-column:1}.stats{grid-template-columns:1fr 1fr}.photo-grid{grid-template-columns:1fr 1fr}.option-grid{grid-template-columns:1fr}.openpoint{grid-template-columns:1fr}.matrix{font-size:10px}.top-actions .secondary{display:none}h1{font-size:52px}}
.breadcrumb{font-size:11px;color:#666;letter-spacing:.02em;margin-bottom:14px;padding-bottom:10px;border-bottom:1px solid var(--line)}.breadcrumb b{color:#111}</style>
</head>
<body>
<div class="app">
<header class="topbar"><div class="brand"><div class="ayno">AYNO</div><div class="sep"></div><div class="sub">A STIM TECH<br>GROUP COMPANY</div><div class="fieldname">FIELD<br><span style="font-size:7px;color:#777">SOPRALLUOGO AV</span></div></div><div class="top-actions"><button class="btn secondary small" onclick="exportFullReport()">PDF PROGETTO</button></div></header>
<div class="shell"><aside class="sidebar">
<button class="navbtn active" onclick="showView('dashboard',this)">Panoramica</button>
<button class="navbtn" onclick="showView('projects',this)">Progetti</button>
<button class="navbtn" onclick="showView('rooms',this)">Sale <span id="roomCountBadge" class="badge">0</span></button>
<button class="navbtn" onclick="showView('openpoints',this)">Punti aperti <span id="openCountBadge" class="badge">0</span></button>
<button class="navbtn" onclick="showView('project',this)">Impostazioni progetto</button>
<div style="height:20px"></div><button class="navbtn" onclick="downloadBackup()">Backup dati</button><div class="footer-note" style="padding:14px 12px">AYNO FIELD · release 0.9.3</div><label class="navbtn" style="cursor:pointer">Ripristina backup<input type="file" accept="application/json" onchange="restoreBackup(event)" style="display:none"></label>
</aside><main class="content" id="content"></main></div></div>
<div id="toast" class="toast"></div>
<div id="modal" class="modal"><div class="modal-card"><div class="modal-head"><h2 id="modalTitle">Sala</h2><button class="close" onclick="closeModal()">×</button></div><div id="modalBody"></div></div></div>
<script>
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const uid=()=>Math.random().toString(36).slice(2,9)+Date.now().toString(36).slice(-4);
const today=()=>new Date().toISOString().slice(0,10);
const defaultProject={configured:false,client:'',project:'',site:'',address:'',latitude:'',longitude:'',locationVerified:'',locationVerifiedAt:'',accessNotes:'',opportunity:'',sales:'',presales:'',customerContact:'',customerEmail:'',customerPhone:'',defaultPlatform:'Microsoft Teams Rooms',date:today(),revision:'0',scope:'',notes:'',deliveryDate:'',workType:'Nuova sala',siteCondition:'Uffici esistenti',stockRoom:'',elevators:'',elevatorDetails:'',drawings:'',itContact:'',standards:'',branding:''};
const PROJECTS_KEY='aynoFieldProjectsV1';
const legacyStored=JSON.parse(localStorage.getItem('aynoFieldStateV4')||localStorage.getItem('aynoFieldStateV2')||'null');
let projectStore=JSON.parse(localStorage.getItem(PROJECTS_KEY)||'null');
if(!projectStore||!Array.isArray(projectStore.projects)){const first={id:uid(),project:{...defaultProject,...(legacyStored?.project||{})},rooms:legacyStored?.rooms||[]};projectStore={version:1,projects:[first],activeProjectId:first.id};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore))}
let activeEntry=projectStore.projects.find(x=>x.id===projectStore.activeProjectId)||projectStore.projects[0]||null;
let state=activeEntry?{project:{...defaultProject,...activeEntry.project},rooms:activeEntry.rooms||[]}:{project:{...defaultProject},rooms:[]};
const legacyMap={'Meeting Room':'Sala riunioni','Boardroom':'Sala consiglio','Training Room':'Sala formazione','Control Room':'Sala controllo','Digital Signage / area TV':'Segnaletica digitale / area TV','Digital Signage / TV Area':'Segnaletica digitale / area TV','LED / Video Wall':'LED / Videowall','Multipurpose':'Sala polifunzionale','Rack / Technical Room':'Locale rack / tecnico','BYOD / UC Agnostic':'BYOD / indipendente dalla piattaforma','Ceiling':'Soffitto','Table':'Tavolo','Mixed':'Misti','Ready':'Pronta','Ready with actions':'Pronta con attività','Not ready':'Non pronta'};
function itValue(v){return legacyMap[v]||v} state.project.defaultPlatform=itValue(state.project.defaultPlatform);
function save(){if(activeEntry){activeEntry.project={...state.project};activeEntry.rooms=state.rooms;projectStore.activeProjectId=activeEntry.id}else{projectStore.activeProjectId=null}localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));renderBadges()}
function toast(t){let e=$('#toast');e.textContent=t;e.classList.add('show');setTimeout(()=>e.classList.remove('show'),2200)}
function esc(s=''){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]))}
function attr(s=''){return esc(s).replace(/`/g,'&#096;')}
function renderBadges(){if(!$('#roomCountBadge'))return;const rooms=activeEntry?(state.rooms||[]):[];$('#roomCountBadge').textContent=rooms.length;$('#openCountBadge').textContent=rooms.reduce((n,r)=>n+(r.openPoints||[]).filter(x=>x.status!=='Chiuso').length,0)}
function showV