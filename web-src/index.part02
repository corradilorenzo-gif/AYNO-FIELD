iew(v,b){$$('.navbtn').forEach(x=>x.classList.remove('active'));if(b)b.classList.add('active');window.currentView=v;render()}
function render(){renderBadges();let v=window.currentView||'dashboard';if(v==='dashboard'){renderDashboard();return}if(v==='projects'){renderProjects();return}if(v==='rooms'){renderRooms();return}if(v==='allrooms'){renderAllRooms();return}if(!activeEntry){renderNoProject(v);return}if(!state.project.configured){renderProjectSetup();return}({openpoints:renderOpenPoints,project:renderProject}[v]||renderDashboard)()}
function renderNoProject(v){$('#content').innerHTML=`<div class="hero"><div><div class="eyebrow">AYNO FIELD</div><h1>Nessun<br><span class="accent">progetto.</span></h1><p class="lead">Crea un progetto per iniziare un sopralluogo e aggiungere sale.</p></div><button class="btn blue" onclick="newProject()">＋ NUOVO PROGETTO</button></div><div class="empty">Non ci sono progetti salvati.</div>`}
function renderProjectSetup(){const p=state.project;$('#content').innerHTML=`<div class="setup-wrap"><div class="setup-head"><div><div class="eyebrow">Nuovo sopralluogo</div><h1>Parti dal<br><span class="accent">progetto.</span></h1></div><p class="lead">I dati generali vengono definiti una sola volta e riportati automaticamente su tutte le sale e sui PDF. Le informazioni provengono anche dalla precedente modulo di sopralluogo AYNO.</p></div><div class="card">${projectFormMarkup(p,true)}</div></div>`}
function projectFormMarkup(p,onboarding=false){return `<form class="form-grid" onsubmit="saveProject(event,${onboarding})">
<div class="group"><div class="group-title"><div><h3>Identificazione progetto</h3></div></div></div>
<div class="field w6"><label>Cliente *</label><input name="client" required value="${attr(p.client)}"></div><div class="field w6"><label>Nome progetto *</label><input name="project" required value="${attr(p.project)}"></div><div class="field w6"><label>Sede *</label><input id="projectSite" name="site" required value="${attr(p.site)}"></div><div class="field w6"><label>Indirizzo</label><input id="projectAddress" name="address" value="${attr(p.address)}" placeholder="Via, CAP, città"></div>
<div class="location-panel"><div><div class="eyebrow">Posizione sede</div><h3 style="margin-top:5px">Geolocalizzazione del sopralluogo</h3><div class="footer-note">Salva il punto GPS della sede solo quando richiesto. Dopo il consenso, le coordinate vengono convertite in indirizzo per compilare automaticamente la sede. Utile per indicazioni stradali, tracciabilità e report PDF.</div><div class="location-status"><span class="location-chip ${p.latitude&&p.longitude?'ok':''}" id="locationChip">${p.latitude&&p.longitude?'GPS salvato':'GPS non salvato'}</span>${p.locationVerified?`<span class="location-chip ok">Posizione verificata</span>`:''}</div></div><div class="location-actions"><button type="button" class="btn secondary small" onclick="useCurrentLocation(event)">⌖ Usa posizione attuale</button><button type="button" class="btn secondary small" onclick="openProjectMap(event)">↗ Apri in Maps</button><button type="button" class="btn ghost small" onclick="toggleMapPreview()">Anteprima mappa</button></div><input type="hidden" id="projectLatitude" name="latitude" value="${attr(p.latitude)}"><input type="hidden" id="projectLongitude" name="longitude" value="${attr(p.longitude)}"><input type="hidden" id="projectLocationVerified" name="locationVerified" value="${attr(p.locationVerified)}"><input type="hidden" id="projectLocationVerifiedAt" name="locationVerifiedAt" value="${attr(p.locationVerifiedAt)}"><div id="mapPreview" class="map-preview"></div></div>
<div class="field w12"><label>Note di accesso alla sede</label><textarea name="accessNotes" placeholder="Reception, ingresso fornitori, parcheggio, badge, piano, ascensore, accessi tecnici...">${esc(p.accessNotes)}</textarea></div>
<div class="field w6"><label>Opportunità / CRM</label><input name="opportunity" value="${attr(p.opportunity)}"></div><div class="field"><label>Data sopralluogo</label><input type="date" name="date" value="${attr(p.date)}"></div><div class="field"><label>Revisione</label><input name="revision" value="${attr(p.revision)}"></div>
<div class="field w6"><label>Commerciale AYNO</label><input name="sales" value="${attr(p.sales)}"></div><div class="field w6"><label>Prevendita / Progettista soluzioni AV</label><input name="presales" value="${attr(p.presales)}"></div>
<div class="field w6"><label>Referente cliente</label><input name="customerContact" value="${attr(p.customerContact)}"></div><div class="field w6"><label>Contatto IT cliente</label><input name="itContact" value="${attr(p.itContact)}"></div>
<div class="field w6"><label>Email referente</label><input name="customerEmail" value="${attr(p.customerEmail)}"></div><div class="field w6"><label>Telefono referente</label><input name="customerPhone" value="${attr(p.customerPhone)}"></div>
<div class="group"><div class="group-title"><div><h3>Condizioni del sito</h3><p>Dati logistici e progettuali comuni alle sale.</p></div></div></div>
<div class="field"><label>Data consegna attesa</label><input type="date" name="deliveryDate" value="${attr(p.deliveryDate)}"></div><div class="field"><label>Tipologia lavorazione</label><select name="workType">${['Nuova sala','Trasloco sala','Upgrade sala esistente','Altro'].map(x=>`<option ${p.workType===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label>Condizioni sito</label><select name="siteCondition">${['Cantiere in corso','Uffici esistenti','Sito di nuova costruzione','Altro'].map(x=>`<option ${p.siteCondition===x?'selected':''}>${x}</option>`).join('')}</select></div>
<div class="field"><label>Area magazzino</label><select name="stockRoom"><option></option><option ${p.stockRoom==='Sì'?'selected':''}>Sì</option><option ${p.stockRoom==='No'?'selected':''}>No</option></select></div><div class="field"><label>Ascensori disponibili</label><select name="elevators"><option></option><option ${p.elevators==='Sì'?'selected':''}>Sì</option><option ${p.elevators==='No'?'selected':''}>No</option></select></div><div class="field"><label>Dettagli ascensori</label><input name="elevatorDetails" value="${attr(p.elevatorDetails)}" placeholder="Tipo e dimensioni"></div>
<div class="field w12"><label>Disegni / documentazione disponibile</label><textarea name="drawings" placeholder="Controsoffitti, floor plan, prospetti pareti, schemi esistenti, as-built...">${esc(p.drawings)}</textarea></div>
<div class="group"><div class="group-title"><div><h3>Standard e ambito</h3></div></div></div>
<div class="field w6"><label>Piattaforma AV predefinita</label><select name="defaultPlatform">${['Microsoft Teams Rooms','Zoom Rooms','Cisco Webex','BYOD / indipendente dalla piattaforma','Da definire'].map(x=>`<option ${p.defaultPlatform===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field w6"><label>Marca / standard cliente</label><input name="standards" value="${attr(p.standards)}" placeholder="Marche richieste, standard globali..."></div><div class="field w6"><label>Pacchetto grafico / interfaccia</label><input name="branding" value="${attr(p.branding)}"></div><div class="field w12"><label>Ambito del sopralluogo</label><textarea name="scope">${esc(p.scope)}</textarea></div><div class="field w12"><label>Note generali</label><textarea name="notes">${esc(p.notes)}</textarea></div>
<div class="field w12 setup-actions">${onboarding?'':`<button type="button" class="btn secondary" onclick="closeModal()">Annulla</button>`}<button class="btn blue" type="submit">${onboarding?'Salva e inizia sopralluogo →':'Salva impostazioni'}</button></div></form>`}
function projectLocationQuery(){let lat=$('#projectLatitude')?.value||state.project.latitude,lon=$('#projectLongitude')?.value||state.project.longitude,address=$('#projectAddress')?.value||state.project.address;if(lat&&lon)return `${lat},${lon}`;return address||state.project.site||''}
function mapsUrl(q){return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`}
function persistProjectLocation(lat,lon,accuracy){let now=new Date().toISOString();let latEl=$('#projectLatitude'),lonEl=$('#projectLongitude'),verifiedEl=$('#projectLocationVerified'),verifiedAtEl=$('#projectLocationVerifiedAt');if(latEl)latEl.value=lat;if(lonEl)lonEl.value=lon;if(verifiedEl)verifiedEl.value='Sì';if(verifiedAtEl)verifiedAtEl.value=now;Object.assign(state.project,{latitude:lat,longitude:lon,locationVerified:'Sì',locationVerifiedAt:now});save();let chip=$('#locationChip');if(chip){chip.textContent=`GPS salvato · ${lat}, ${lon}${accuracy?` · ±${Math.round(accuracy)} m`:''}`;chip.classList.add('ok')}let box=$('#mapPreview');if(box&&box.classList.contains('show'))box.innerHTML=`<iframe title="Mappa sede" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=${encodeURIComponent(lat+','+lon)}&output=embed"></iframe>`}
function getFreshLocation(onSuccess,onError){if(!navigator.geolocation){onError&&onError({code:0});return}navigator.geolocation.getCurrentPosition(pos=>{let lat=pos.coords.latitude.toFixed(6),lon=pos.coords.longitude.toFixed(6);persistProjectLocation(lat,lon,pos.coords.accuracy);onSuccess&&onSuccess(lat,lon,pos.coords.accuracy)},err=>{onError&&onError(err)},{enableHighAccuracy:true,timeout:20000,maximumAge:0})}
function formatReverseAddress(data){let a=data&&data.address||{};let locality=a.city||a.town||a.village||a.municipality||a.suburb||a.county||'';let road=a.road||a.pedestrian||a.footway||a.residential||a.neighbourhood||'';let number=a.house_number||'';let postcode=a.postcode||'';let province=a.province||a.county||a.state_district||'';let first=[road,number].filter(Boolean).join(' ');let second=[postcode,locality].filter(Boolean).join(' ');let address=[first,second,province].filter(Boolean).join(', ');return{site:locality,address:address||data?.display_name||''}}
async function reverseGeocodeLocation(lat,lon){let url=`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${encodeURIComponent(lat)}&lon=${encodeURIComponent(lon)}&zoom=18&addressdetails=1&accept-language=it`;let res=await fetch(url,{headers:{'Accept':'application/json'}});if(!res.ok)throw new Error('reverse-geocoding');let data=await res.json();return formatReverseAddress(data)}
async function fillProjectAddressFromGps(lat,lon){try{let place=await reverseGeocodeLocation(lat,lon),siteEl=$('#projectSite'),addressEl=$('#projectAddress');if(addressEl&&place.address){addressEl.value=place.address;state.project.address=place.address}if(siteEl&&place.site&&!siteEl.value.trim()){siteEl.value=place.site;state.project.site=place.site}save();return place}catch(err){console.warn('Reverse geocoding non disponibile',err);return null}}
function openProjectMap(ev){let btn=ev?.currentTarget,old=btn?.textContent;if(btn){btn.disabled=true;btn.textContent='Aggiorno posizione…'}getFreshLocation(async(lat,lon,accuracy)=>{if(btn)btn.textContent='Ricavo indirizzo…';await fillProjectAddressFromGps(lat,lon);if(btn){btn.disabled=false;btn.textContent=old}toast(`Posizione aggiornata · precisione ±${Math.round(accuracy)} m`);window.open(mapsUrl(lat+','+lon),'_blank','noopener')},err=>{if(btn){btn.disabled=false;btn.textContent=old}let q=projectLocationQuery();if(q){toast('GPS non aggiornabile: apro la posizione salvata');window.open(mapsUrl(q),'_blank','noopener')}else{let msg=err&&err.code===1?'Permesso posizione negato':err&&err.code===2?'Posizione non disponibile':'Impossibile ottenere la posizione';toast(msg)}})}
function toggleMapPreview(){let box=$('#mapPreview');if(!box)return;let q=projectLocationQuery();if(!q)return toast('Inserisci un indirizzo o salva la posizione GPS');if(box.classList.contains('show')){box.classList.remove('show');box.innerHTML='';return}box.innerHTML=`<iframe title="Mappa sede" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=${encodeURIComponent(q)}&output=embed"></iframe>`;box.classList.add('show')}
function useCurrentLocation(ev){let btn=ev?.currentTarget,old=btn?.textContent;if(btn){btn.disabled=true;btn.textContent='Ricerca posizione…'}getFreshLocation(async(lat,lon,accuracy)=>{if(btn)btn.textContent='Ricavo indirizzo…';let place=await fillProjectAddressFromGps(lat,lon);if(btn){btn.disabled=false;btn.textContent=old}if(place&&place.address)toast(`Posizione e indirizzo aggiornati · precisione ±${Math.round(accuracy)} m`);else toast(`Coordinate GPS salvate · indirizzo non disponibile · ±${Math.round(accuracy)} m`)},err=>{if(btn){btn.disabled=false;btn.textContent=old}let msg=err&&err.code===1?'Permesso posizione negato':err&&err.code===2?'Posizione non disponibile':'Tempo scaduto per la geolocalizzazione';toast(msg+' — usa localhost/HTTPS e abilita la posizione')})}
function saveProject(e,onboarding){e.preventDefault();Object.assign(state.project,Object.fromEntries(new FormData(e.target)),{configured:true});save();if(onboarding)window.currentView='dashboard';closeModal();render();toast('Impostazioni salvate')}
function openProjectModal(){$('#modalTitle').textContent='Impostazioni progetto';$('#modalBody').innerHTML=projectFormMarkup(state.project,false);openModal()}
function readinessClass(x){return x==='Pronta'?'ready':x==='Pronta con attività'?'conditional':'notready'}
function blankRoom(){return{id:uid(),name:'',floor:'',code:'',type:'Sala riunioni',capacity:'',width:'',length:'',height:'',platform:state.project.defaultPlatform,requirements:'',roomUse:'',tableShape:'Rettangolare',tableA:'',tableB:'',tableC:'',tableMaterial:'',existingTable:'',newTable:'',clientCutouts:'',tableBoxes:'',wall1:'',wall1Finish:'',wall1Containment:'',wall1Reinforce:'',wall1Fit:'',wallsOther:'',floorType:'',ceilingType:'',ceilingAccessible:'',ceilingObstructions:'',existingAV:'',display:'',camera:'',audio:'',microphoneType:'',network:'',power:'',rack:'',rackLocation:'',rackVentilation:'',cabling:'',verticalRoute:'',cableVoid:'',constructionWorks:'',constructionOwner:'',acoustics:'',lighting:'',issues:'',recommendation:'',notes:'',readiness:'Pronta con attività',readinessNotes:'',paths:[{id:uid(),label:'Tavolo → Display',available:'',route:'',length:'',notes:''},{id:uid(),label:'Tavolo → Rack',available:'',route:'',length:'',notes:''},{id:uid(),label:'Rack → Display',available:'',route:'',length:'',notes:''},{id:uid(),label:'Rack → Camera',available:'',route:'',length:'',notes:''}],matrix:{display:{power:'',network:'',poe:'',av:''},camera:{power:'',network:'',poe:'',av:''},touch:{power:'',network:'',poe:'',av:''},table:{power:'',network:'',poe:'',av:''},rack:{power:'',network:'',poe:'',av:''},scheduler:{power:'',network:'',poe:'',av:''}},photos:[],openPoints:[]}}
function normalizeRoom(r){let b=blankRoom(),x={...b,...r,matrix:{...b.matrix,...(r.matrix||{})},photos:r.photos||[],openPoints:r.openPoints||[],paths:r.paths||b.paths};x.type=itValue(x.type);x.platform=itValue(x.platform);x.microphoneType=itValue(x.microphoneType);x.readiness=itValue(x.readiness);return x}
function completion(r){let keys=['name','floor','type','capacity','width','length','height','roomUse','wall1','ceilingType','network','power','readiness'];let d=keys.filter(k=>String(r[k]||'').trim()).length;return Math.round(d/keys.length*100)}
function renderProjects(){save();const entries=projectStore.projects||[];const cards=entries.map(e=>{const p={...defaultProject,...e.project},rooms=e.rooms||[],active=!!activeEntry&&e.id===activeEntry.id;return `<article class="project-card ${active?'active-project':''}"><div><div class="eyebrow">${active?'Progetto aperto':'Progetto salvato'}</div><h3>${esc(p.project||'Nuovo progetto')}</h3><div class="meta">${esc(p.client||'Cliente da definire')} · ${esc(p.site||'Sede da definire')}</div><div class="meta" style="margin-top:8px">${rooms.length} ${rooms.length===1?'sala':'sale'} · sopralluogo ${esc(p.date||'-')}</div></div><div class="project-card-actions"><button class="btn ${active?'secondary':'blue'} small" onclick="switchProject('${e.id}')">${active?'APERTO':'APRI'}</button><button class="btn ghost small" onclick="duplicateProject('${e.id}')">DUPLICA</button><button class="btn danger small" onclick="deleteProject('${e.id}')">ELIMINA</button></div></article>`}).join('');$('#content').innerHTML=`<div class="hero"><div><div class="eyebrow">Archivio</div><h1>I tuoi<br><span class="accent">progetti.</span></h1><p class="lead">Ogni progetto conserva separatamente impostazioni, sede, sale, foto, punti aperti e dati di sopralluogo.</p></div><button class="btn blue" onclick="newProject()">＋ NUOVO PROGETTO</button></div>${cards?`<div class="projects-grid">${cards}</div>`:`<div class="empty"><b>Nessun progetto salvato.</b><br><br><button class="btn blue" onclick="newProject()">＋ CREA IL PRIMO PROGETTO</button></div>`}`}
function switchProject(id){save();const e=projectStore.projects.find(x=>x.id===id);if(!e)return;activeEntry=e;projectStore.activeProjectId=id;state={project:{...defaultProject,...e.project},rooms:(e.rooms||[]).map(normalizeRoom)};localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));window.currentView=state.project.configured?'rooms':'project';render();toast('Progetto aperto')}
function duplicateProject(id){save();const src=projectStore.projects.find(x=>x.id===id);if(!src)return;const cp=JSON.parse(JSON.stringify(src));cp.id=uid();cp.project.project=(cp.project.project||'Progetto')+' — copia';cp.rooms=(cp.rooms||[]).map(r=>({...r,id:uid(),photos:[],openPoints:(r.openPoints||[]).map(o=>({...o,id:uid()}))}));projectStore.projects.push(cp);localStorage.setItem(PROJECTS_KEY,JSON.stringify(projectStore));renderProjects();toast('Progetto duplicato')}
function deleteProject(id){const e=projectStore.projects.find(x=>x.id===id);if(!e)return;if(!confirm(`Eliminare il progetto “${e?.project?.project||'senza nome'}” e tutte le sue sale? Questa operazione non può essere annullata.`))return;projectStore.projects=projectStore.projects.filter(x=>x.id!==id);if(activeEntry&&a