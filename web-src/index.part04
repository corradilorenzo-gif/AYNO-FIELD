dle room.',
'Medium Room':'7–12 persone · meeting room standard.',
'Large Room':'12–20 persone · meeting room di grandi dimensioni.',
'Boardroom':'Sala consiglio / executive room con tavolo centrale e AV evoluto.',
'U-Shape Room':'20–30 persone · tavoli disposti a ferro di cavallo.',
'Training Room':'20–40 persone · disposizione didattica con più file di tavoli.',
'Sala combinabile':'Due o più sale divisibili/unibili con pareti mobili e impianto AV coordinato.',
'Auditorium':'Plateа orientata verso palco o parete frontale; tipicamente amplificazione e regia.',
'Town Hall':'Spazio all-hands / corporate event, spesso con palco, pubblico numeroso, streaming o overflow.',
'Altro':'Layout speciale o ambiente non riconducibile alle tipologie standard.'};return hints[type]||'Seleziona la tipologia che descrive meglio l’ambiente.'}
function roomTypeSelector(selected){const blue='#114c96',ink='#111',chair='#9ed7c9',wall='#d7d9d7',table='#f3f3f1';
const seat=(x,y,w=9,h=7)=>`<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="2" fill="${chair}"/>`;
const screen=(x,y,w=42)=>`<rect x="${x}" y="${y}" width="${w}" height="8" rx="1" fill="${blue}"/>`;
const label=(t,x,y)=>`<text x="${x}" y="${y}" font-size="8" fill="#5e5e59" font-weight="700">${t}</text>`;
const cards=[
{name:'Phone Room',meta:'1–2 persone',purpose:'Chiamate rapide / 1:1',desc:'Ambiente minimo: monitor frontale, piccolo piano d’appoggio e 1–2 sedute.',svg:`<svg viewBox="0 0 180 110"><rect x="18" y="14" width="82" height="78" rx="3" fill="none" stroke="${wall}" stroke-width="6"/>${screen(38,24,40)}<rect x="48" y="49" width="40" height="20" rx="3" fill="${table}" stroke="${ink}"/>${seat(61,76,13,9)}${label('DISPLAY',40,19)}${label('1–2 POSTI',112,58)}<path d="M98 58h32" stroke="${blue}" stroke-width="1.5"/><path d="M126 54l6 4-6 4" fill="none" stroke="${blue}" stroke-width="1.5"/></svg>`},
{name:'Small Room',meta:'3–7 persone',purpose:'Huddle / piccola riunione',desc:'Tavolo compatto con partecipanti attorno e display sulla parete frontale.',svg:`<svg viewBox="0 0 180 110"><rect x="17" y="14" width="146" height="82" rx="3" fill="none" stroke="${wall}" stroke-width="5"/>${screen(69,20,42)}<rect x="60" y="43" width="60" height="28" rx="7" fill="${table}" stroke="${ink}"/>${seat(64,32)}${seat(83,32)}${seat(102,32)}${seat(64,76)}${seat(83,76)}${seat(102,76)}${label('DISPLAY',72,16)}${label('TAVOLO',75,59)}</svg>`},
{name:'Medium Room',meta:'7–12 persone',purpose:'Meeting room standard',desc:'Tavolo più lungo, maggiore distanza dal display e più posti distribuiti sui lati.',svg:`<svg viewBox="0 0 180 110"><rect x="13" y="11" width="154" height="88" rx="3" fill="none" stroke="${wall}" stroke-width="5"/>${screen(68,17,45)}<rect x="49" y="42" width="82" height="31" rx="7" fill="${table}" stroke="${ink}"/>${[53,70,87,104,121].map(x=>seat(x,30,8,7)).join('')}${[53,70,87,104,121].map(x=>seat(x,78,8,7)).join('')}${label('7–12 POSTI',123,22)}<path d="M90 27v12" stroke="${blue}" stroke-dasharray="3 2"/></svg>`},
{name:'Large Room',meta:'12–20 persone',purpose:'Riunione ampia / executive',desc:'Tavolo lungo con molti partecipanti; richiede più attenzione a camera, audio e distanze.',svg:`<svg viewBox="0 0 180 110"><rect x="9" y="9" width="162" height="92" rx="3" fill="none" stroke="${wall}" stroke-width="5"/>${screen(65,15,50)}<rect x="37" y="40" width="106" height="34" rx="6" fill="${table}" stroke="${ink}"/>${[39,55,71,87,103,119,135].map(x=>seat(x,28,8,7)).join('')}${[39,55,71,87,103,119,135].map(x=>seat(x,79,8,7)).join('')}${seat(24,48,8,9)}${seat(149,48,8,9)}${label('12–20 POSTI',119,19)}<path d="M90 25v12" stroke="${blue}" stroke-dasharray="3 2"/></svg>`},
{name:'Boardroom',meta:'Executive / consiglio',purpose:'Consiglio / direzione',desc:'Tavolo centrale prestigioso, posti anche alle testate e AV tipicamente più evoluto.',svg:`<svg viewBox="0 0 180 110"><rect x="10" y="10" width="160" height="90" rx="3" fill="none" stroke="${wall}" stroke-width="5"/>${screen(65,16,50)}<rect x="48" y="38" width="84" height="38" rx="18" fill="${table}" stroke="${ink}" stroke-width="1.4"/>${[54,73,92,111].map(x=>seat(x,27,9,7)).join('')}${[54,73,92,111].map(x=>seat(x,81,9,7)).join('')}${seat(34,51,8,11)}${seat(138,51,8,11)}${label('EXECUTIVE',118,20)}<circle cx="90" cy="57" r="6" fill="none" stroke="${blue}" stroke-width="1.5"/><path d="M90 48v18M81 57h18" stroke="${blue}" stroke-width="1"/></svg>`},
{name:'U-Shape Room',meta:'20–30 persone',purpose:'Workshop / formazione',desc:'Tavoli a ferro di cavallo con area libera centrale e fronte relatore.',svg:`<svg viewBox="0 0 180 110">${screen(67,12,46)}<path d="M38 34v49h104V34" fill="none" stroke="${ink}" stroke-width="10"/>${[43,60,77,94,111,128].map(x=>seat(x,88,8,6)).join('')}${seat(24,38,7,9)}${seat(24,56,7,9)}${seat(149,38,7,9)}${seat(149,56,7,9)}${label('AREA CENTRALE',62,61)}</svg>`},
{name:'Training Room',meta:'20–40 persone',purpose:'Aula / formazione',desc:'Più file orientate verso docente, podio o display frontale.',svg:`<svg viewBox="0 0 180 110">${screen(67,10,46)}${label('DOCENTE',72,32)}${[43,67,91].map(y=>`<rect x="39" y="${y}" width="102" height="8" rx="2" fill="${table}" stroke="${ink}"/>${[45,64,83,102,121].map(x=>seat(x,y+12,8,6)).join('')}`).join('')}</svg>`},
{name:'Sala combinabile',meta:'Room combine',purpose:'Sale divisibili / unibili',desc:'Due o più ambienti separabili da parete mobile con AV indipendente o coordinato.',svg:`<svg viewBox="0 0 180 110"><rect x="14" y="15" width="152" height="78" fill="none" stroke="${wall}" stroke-width="5"/><line x1="90" y1="15" x2="90" y2="93" stroke="${blue}" stroke-width="3" stroke-dasharray="6 5"/>${screen(31,23,35)}${screen(114,23,35)}<rect x="31" y="48" width="42" height="20" fill="${table}" stroke="${ink}"/><rect x="108" y="48" width="42" height="20" fill="${table}" stroke="${ink}"/><path d="M78 57h24" stroke="${blue}" stroke-width="2"/><path d="M98 52l6 5-6 5" fill="none" stroke="${blue}" stroke-width="2"/>${label('PARETE MOBILE',66,105)}</svg>`},
{name:'Auditorium',meta:'Plateа + palco',purpose:'Presentazioni / eventi',desc:'Plateа rivolta verso palco o schermo; tipicamente PA, microfoni e regia.',svg:`<svg viewBox="0 0 180 110"><rect x="52" y="13" width="76" height="12" fill="${blue}"/>${label('PALCO / SCHERMO',57,10)}${[38,56,74,92].map(y=>[45,63,81,99,117,135].map(x=>`<circle cx="${x}" cy="${y}" r="4.5" fill="${chair}"/>`).join('')).join('')}<rect x="38" y="101" width="104" height="5" fill="${wall}"/></svg>`},
{name:'Town Hall',meta:'All-hands / evento',purpose:'Evento corporate / streaming',desc:'Pubblico numeroso, palco e spesso più camere, streaming o partecipazione remota.',svg:`<svg viewBox="0 0 180 110"><rect x="60" y="12" width="60" height="14" fill="${blue}"/>${label('PALCO',76,9)}<rect x="26" y="16" width="18" height="14" fill="none" stroke="${blue}" stroke-width="2"/><rect x="136" y="16" width="18" height="14" fill="none" stroke="${blue}" stroke-width="2"/>${label('CAM',22,39)}${label('CAM',135,39)}${[48,65,82].map(y=>[42,58,74,90,106,122,138].map(x=>`<circle cx="${x}" cy="${y}" r="4" fill="${chair}"/>`).join('')).join('')}<path d="M90 31v10" stroke="${blue}" stroke-dasharray="3 2"/></svg>`},
{name:'Altro',meta:'Layout speciale',purpose:'Ambiente non standard',desc:'Usalo quando il locale non rientra nelle tipologie precedenti.',svg:`<svg viewBox="0 0 180 110"><path d="M45 24l50-12 42 18 15 43-30 24-62-5-24-35z" fill="none" stroke="${ink}" stroke-width="2" stroke-dasharray="6 4"/><text x="91" y="66" text-anchor="middle" font-size="28" fill="${blue}" font-weight="700">?</text></svg>`}
];return `<div class="roomtype-grid">${cards.map(c=>`<label class="roomtype-card"><input type="radio" name="type" value="${c.name}" ${selected===c.name?'checked':''} onchange="updateRoomTypeHint(this.value)"><div class="roomtype-inner"><div><div class="roomtype-card-title">${c.name}</div><div class="roomtype-card-meta">${c.meta}</div><div class="roomtype-purpose">${c.purpose}</div></div><div class="roomtype-visual">${c.svg}</div><div class="roomtype-card-desc">${c.desc}</div></div></label>`).join('')}</div><div class="roomtype-hint" id="roomTypeHint"><b>${selected||'Tipologia sala'}</b> · ${roomTypeHint(selected)}</div>`}
function updateRoomTypeHint(type){const el=document.getElementById('roomTypeHint');if(el)el.innerHTML=`<b>${type}</b> · ${roomTypeHint(type)}`}
function roomForm(r){r=normalizeRoom(r);return `<form id="roomForm" class="form-grid" onsubmit="saveRoom(event)">
<div class="group"><div class="group-title"><div><h3>Panoramica</h3><p>Dati base, utilizzo e tipologia ambiente.</p></div></div></div>
<div class="field w6"><label>Nome sala *</label><input required name="name" value="${attr(r.name)}"></div><div class="field"><label>Piano</label><input name="floor" value="${attr(r.floor)}"></div><div class="field"><label>Numero / codice sala</label><input name="code" value="${attr(r.code)}"></div>
<div class="field w12"><label>Tipologia sala *</label>${roomTypeSelector(r.type)}</div><div class="field"><label>Capienza effettiva</label><input type="number" name="capacity" value="${attr(r.capacity)}"></div><div class="field w6"><label>Piattaforma</label><select name="platform">${['Microsoft Teams Rooms','Zoom Rooms','Cisco Webex','BYOD / indipendente dalla piattaforma','Da definire'].map(x=>`<option ${r.platform===x?'selected':''}>${x}</option>`).join('')}</select></div>
<div class="field w12"><label>Descrizione utilizzo sala</label><textarea name="roomUse">${esc(r.roomUse||r.requirements)}</textarea></div>
<div class="group"><div class="group-title"><div><h3>Spazio</h3><p>Dimensioni, tavolo, pareti, pavimento e controsoffitto.</p></div></div></div>
<div class="field"><label>Larghezza m</label><input type="number" step="0.01" name="width" value="${attr(r.width)}"></div><div class="field"><label>Lunghezza m</label><input type="number" step="0.01" name="length" value="${attr(r.length)}"></div><div class="field"><label>Altezza m</label><input type="number" step="0.01" name="height" value="${attr(r.height)}"></div>
<div class="field w12"><label>Forma tavolo</label>${tableShapeSelector(r.tableShape)}</div><div class="field"><label>Dimensione A mm</label><input name="tableA" placeholder="Es. 3200" value="${attr(r.tableA)}"></div><div class="field"><label>Dimensione B mm</label><input name="tableB" placeholder="Es. 1200" value="${attr(r.tableB)}"></div><div class="field"><label>Dimensione C mm</label><input name="tableC" placeholder="Solo se utile" value="${attr(r.tableC)}"></div><div class="field"><label>Materiale tavolo</label><input name="tableMaterial" value="${attr(r.tableMaterial)}"></div><div class="field"><label>Tavolo esistente</label>${yn('existingTable',r.existingTable)}</div><div class="field"><label>Nuovo tavolo previsto</label>${yn('newTable',r.newTable)}</div><div class="field"><label>Fori / aperture a carico cliente</label>${yn('clientCutouts',r.clientCutouts)}</div><div class="field"><label>Scatole da tavolo necessarie</label>${yn('tableBoxes',r.tableBoxes)}</div>
<div class="field"><label>Parete display</label><select name="wall1"><option></option>${['Muratura','Cartongesso','Vetro','Legno / boiserie','Altro'].map(x=>`<option ${r.wall1===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label>Finitura / dettagli parete</label><input name="wall1Finish" value="${attr(r.wall1Finish)}"></div><div class="field"><label>Contenimenti presenti</label>${yn('wall1Containment',r.wall1Containment)}</div><div class="field"><label>Rinforzo necessario</label>${yn('wall1Reinforce',r.wall1Reinforce)}</div><div class="field"><label>Apparati installabili sulla parete</label>${yn('wall1Fit',r.wall1Fit)}</div><div class="field"><label>Pavimento</label><select name="floorType"><option></option><option ${r.floorType==='Solido'?'selected':''}>Solido</option><option ${r.floorType==='Galleggiante'?'selected':''}>Galleggiante</option><option ${r.floorType==='Altro'?'selected':''}>Altro</option></select></div><div class="field w12"><label>Altre pareti / note architettoniche</label><textarea name="wallsOther">${esc(r.wallsOther)}</textarea></div>
<div class="field"><label>Controsoffitto</label><select name="ceilingType"><option></option>${['Muratura / soletta','Cartongesso continuo','Pannelli removibili','Assente','Altro'].map(x=>`<option ${r.ceilingType===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field"><label>Controsoffitto accessibile</label>${yn('ceilingAccessible',r.ceilingAccessible)}</div><div class="field w6"><label>Ostacoli / criticità soffitto</label><textarea name="ceilingObstructions" placeholder="HVAC, sprinkler, luci, rilevatori, fan coil, isolamento, diffusori esistenti...">${esc(r.ceilingObstructions)}</textarea></div>
<div class="group"><div class="group-title"><div><h3>Impianto esistente</h3><p>Apparati e funzioni esistenti da mantenere o sostituire.</p></div></div></div>
<div class="field w12"><label>AV esistente — marca, modello, quantità, riutilizzo</label><textarea name="existingAV">${esc(r.existingAV)}</textarea></div><div class="field w6"><label>Display / LED / proiezione</label><textarea name="display">${esc(r.display)}</textarea></div><div class="field w6"><label>Telecamera / videoconferenza</label><textarea name="camera">${esc(r.camera)}</textarea></div><div class="field w6"><label>Audio / diffusori</label><textarea name="audio">${esc(r.audio)}</textarea></div><div class="field w6"><label>Microfoni</label><select name="microphoneType"><option></option>${['Soffitto','Tavolo','Wireless','Misti','Non richiesti'].map(x=>`<option ${r.microphoneType===x?'selected':''}>${x}</option>`).join('')}</select></div>
<div class="group"><div class="group-title"><div><h3>Infrastruttura</h3><p>Alimentazione, LAN, PoE, percorsi cavi e predisposizioni.</p></div></div></div>
<div class="field w6"><label>Rete / VLAN / PoE</label><textarea name="network">${esc(r.network)}</textarea></div><div class="field w6"><label>Alimentazione / prese / circuiti</label><textarea name="power">${esc(r.power)}</textarea></div><div class="field"><label>Passaggio cavi nel vano</label>${yn('cableVoid',r.cableVoid)}</div><div class="field"><label>Passaggio verticale accessibile</label>${yn('verticalRoute',r.verticalRoute)}</div><div class="field w6"><label>Cablaggi / percorsi / distanze</label><textarea name="cabling">${esc(r.cabling)}</textarea></div><div class="field w12"><label>Percorsi AV principali</label><div class="footer-note" style="margin-bottom:8px">Solo i passaggi utili al sopralluogo: disponibilità, via di passaggio e lunghezza indicativa.</div>${pathEditorMarkup(r)}</div>
<div class="field w12"><label>Matrice predisposizioni</label><table class="matrix"><thead><tr><th>Posizione / dispositivo</th><th>Alimentazione</th><th>LAN</th><th>PoE</th><th>AV</th></tr></thead><tbody>${[['display','Display'],['camera','Telecamera'],['touch','Pannello touch'],['table','Tavolo AV'],['rack','Rack'],['scheduler','Pannello prenotazione sala']].map(([d,l])=>`<tr><td>${l}</td><td>${matrixCell(d,'power',r.matrix[d]?.power)}</td><td>${matrixCell(d,'network',r.matrix[d]?.network)}</td><td>${matrixCell(d,'poe',r.matrix[d]?.poe)}</td><td>${matrixCell(d,'av',r.matrix[d]?.av)}</td></tr>`).join('')}</tbody></table></div>
<div class="group"><div class="group-title"><div><h3>Posizionamento apparati e opere</h3><p>Rack, mobile tecnico, opere e adeguamenti.</p></div></div></div>
<div class="field"><label>Posizione rack</label><input name="rackLocation" value="${attr(r.rackLocation)}" placeholder="Locale tecnico, mobile..."></div><div class="field"><label>Ventilazione rack</label>${yn('rackVentilation',r.rackVentilation)}</div><div class="field w6"><label>Rack / arredi tecnici</label><textarea name="rack">${esc(r.rack)}</textarea></div><div class="field"><label>Opere / predisposizioni necessarie</label>${yn('constructionWorks',r.constructionWorks)}</div><div class="field"><label>Responsabile opere</label><input name="constructionOwner" value="${attr(r.constructionOwner)}" placeholder="Cliente, impresa, IT..."></div><div class="field w12"><label>Dettaglio opere</label><textarea name="issues" placeholder="Corrugati, floorbox, rinforzi, fori tavolo, trattamenti acustici, adeguamenti...">${esc(r.issues)}</textarea></div>
<div class="group"><div class="group-title"><div><h3>Ambiente</h3><p>Valutazioni qualitative con impatto AV.</p></div></div></div>
<div class="field w6"><label>Acustica</label><textarea name="acoustics">${esc(r.acoustics)}</textarea></div><div class="field w6"><label>Illuminazione / finestre / luce naturale</label><textarea name="lighting">${esc(r.lighting)}</textarea></div>
<div class="group"><div class="group-title"><div><h3>Stato di prontezza della sala</h3><p>Valutazione finale della sala rispetto all'installazione.</p></div></div></div>
<div class="field"><label>Stato</label><select name="readiness"><option ${r.readiness==='Pronta'?'selected':''}>Pronta</option><option ${r.readiness==='Pronta con attività'?'selected':''}>Pronta con attività</option><option ${r.readiness==='Non pronta'?'selected':''}>Non pronta</option></select></div><div class="field w8"><label>Motivazione / criticità bloccanti</label><textarea name="readinessNotes">${esc(r.readinessNotes)}</textarea></div>
<div class="group"><div class="group-title"><div><h3>Soluzione</h3></div></div></div><div class="field w12"><label>Raccomandazione prevendita</label><textarea name="recommendation">${esc(r.recommendation)}</textarea></div><div class="field w12"><label>Note</label><textarea name="notes">${esc(r.notes)}</textarea></div>
<div class="group"><div class="group-title"><div><h3>Foto</h3><p>Le immagini vengono incluse nel PDF della sala.</p></div></div></div><div class="field w12"><div class="photo-grid">${photosMarkup(r)}<label class="photo-add">＋ Aggiungi foto<input type="file" accept="image/*" capture="environment" multiple onchange="addPhotos(event)"></label></div></div>
<div class="group"><div class="group-title"><div><h3>Punti aperti</